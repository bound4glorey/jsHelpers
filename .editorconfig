# Keeps formatting consistent in any editor — see https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
# trailing spaces are a line break in Markdown
trim_trailing_whitespace = false
